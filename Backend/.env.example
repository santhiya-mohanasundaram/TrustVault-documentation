# TrustVault Backend Environment Configuration Example
# Copy to .env and configure local credentials

SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/trustvault_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
JWT_SECRET=your_base64_encoded_or_hex_jwt_secret_key_minimum_256_bits_length_here
JWT_EXPIRATION=86400000

# Mail Server Configuration (Optional for real SMTP, fallback mode supported)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_app_password

# File Storage Configuration
FILE_STORAGE_PATH=./uploads/documents

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5173
